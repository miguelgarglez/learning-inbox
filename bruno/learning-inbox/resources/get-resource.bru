meta {
  name: Get resource by id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/resources/{{resourceId}}
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: localhost:8080
}

tests {
  test("returns 200 for stored resource", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("id matches runtime variable", function () {
    expect(res.body.id).to.equal(bru.getVar("resourceId"));
  });
}
